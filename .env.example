# Anti-Money Laundering (AML) Suspicious Activity Detector Configuration Environment File

# Active LLM Provider: groq | openrouter | ollama | lmstudio | openai
PROVIDER=groq
MODEL_ID=llama-3.3-70b-versatile
FALLBACK_MODEL_ID=llama-3.1-8b-instant
TEMPERATURE=0.0

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434

# LM Studio Local OpenAI-Compatible Server Configuration
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Generic OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# App & Storage Paths
DB_PATH=activity.duckdb
RAW_DATA_DIR=dataset
PROCESSED_DATA_DIR=data/processed

# Logging Configuration
LOG_LEVEL=INFO
DEV_MODE=True
